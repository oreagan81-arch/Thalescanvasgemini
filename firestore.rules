rules_version = '2';
service cloud.firestore {
match /databases/{database}/documents {

function isAuthenticated() {
  return request.auth != null;
}

function getUserData() {
  return isAuthenticated()
    ? get(/databases/$(database)/documents/users/$(request.auth.uid)).data
    : null;
}

function isAdmin() {
  return isAuthenticated() && getUserData().role == 'admin';
}

function isTeacher() {
  return isAuthenticated() && getUserData().role == 'teacher';
}

// 🔒 SAFE FIELD CHECK
function existsField(data, field) {
  return data[field] != null;
}

// 🔒 VALIDATION
function isValidTitle(title) {
  return title is string
    && title.matches('^(SM5|RM4|ELA4)(: ?| )?.+');
}

function isValidGroup(group) {
  return group in [
    'Homework/Class Work',
    'Homework',
    'Written Assessments',
    'Fact Assessments',
    'Reading Assessments',
    'Check Outs'
  ];
}

function isValidIdempotencyKey(key) {
  return key is string
    && key.matches('^[a-zA-Z0-9\\-_]+$');
}

function isValidAssignment(data) {
  return existsField(data, 'title')
    && existsField(data, 'group')
    && existsField(data, 'idempotencyKey')
    && existsField(data, 'due_at')
    && existsField(data, 'subject')
    && isValidTitle(data.title)
    && isValidGroup(data.group)
    && isValidIdempotencyKey(data.idempotencyKey);
}

// 🔒 SAFE THROTTLE (no crash if missing)
function isAllowedWrite() {
  return isAuthenticated()
    && (
      !( 'lastWrite' in getUserData() )
      || request.time.toMillis() - getUserData().lastWrite.toMillis() > 3000
    );
}

// USERS
match /users/{userId} {
  allow read, write: if isAdmin() || (isAuthenticated() && request.auth.uid == userId);
}

// CONFIG
match /system_config/global {
  allow read: if isAuthenticated();
  allow write: if isAdmin();
}

// ASSIGNMENTS
match /assignments/{assignmentId} {
  allow read: if isAuthenticated();

  allow create: if isTeacher()
    && isValidAssignment(request.resource.data)
    && isAllowedWrite();

  // 🔒 prevent duplicates by idempotencyKey (query-safe approach)
  allow update, delete: if isAdmin();
}

// ANNOUNCEMENTS
match /announcements/{announcementId} {
  allow read: if isAuthenticated();

  allow create: if isTeacher()
    && request.resource.data.draft == true
    && isAllowedWrite();

  allow update, delete: if isAdmin()
    || (isTeacher() && resource.data.draft == true);
}

// JOBS
match /jobs/{jobId} {
  allow read: if isAdmin()
    || (isAuthenticated() && resource.data.createdBy == request.auth.uid);

  allow create: if isTeacher();

  allow update, delete: if isAdmin();
}

// METRICS
match /metrics/global {
  allow read: if isAuthenticated();
  allow write: if isAdmin();
}

// LOGS
match /logs/{logId} {
  allow read, write: if isAdmin();
}

}
}
